  "movie_staging": {
    "TV Series": {
      "output": "/path/to/your/series/library",
      "description": {
        "en": "The TV series, one folder per show. A Plex library used on its own (Plex shows it as **TV Shows**): Plex recognises the episodes by their names, so it does not have to be perfectly tidy.",
        "it": "Le serie TV, una cartella per serie. Una libreria Plex usata da sola (Plex la mostra come **TV Shows**): Plex riconosce gli episodi dai nomi, quindi non serve che sia perfettamente in ordine."
      }
    },
    "downloads": {
      "inbox": "/path/to/dirty/downloads",
      "output": "/path/where/finished/films/go",
      "description": {
        "en": "Where finished downloads land — both torrents (**🧲 Torrents**) and hoster/debrid downloads (**⬇ Downloads**) end up in the inbox by themselves.",
        "it": "Qui arrivano i download finiti — sia i torrent (**🧲 Torrents**) sia i download da hoster/debrid (**⬇ Downloads**) finiscono da soli nell'inbox."
      }
    }
  },
  "music_staging": {
    "Audio": {
      "inbox": "/path/to/songs/waiting",
      "output": "/path/where/tagged/songs/go",
      "description": {
        "en": "Songs waiting to be recognised, tagged and filed as Artist/Album/NN - Title.",
        "it": "Canzoni in attesa di essere riconosciute, taggate e archiviate come Artista/Album/NN - Titolo."
      }
    }
  },
  "users": {
    "alice": {
      "token": "replace-with-a-long-random-token",
      "permissions": {
        "publish": false
      }
    }
  }
