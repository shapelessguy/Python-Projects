# Vite dev server (npm run dev).
WEB_PORT=5173

# API backend port (also the local uvicorn bind port).
API_PORT=8000


PUBLIC_HOST=xxx

# Root for all generated/runtime data: api's sqlite DBs + food images
# (<DATA_DIR>/api/data), the forecast cache (<DATA_DIR>/forecast/datasets),
# and the historical weather CSVs from utilities/update_data.py
# (<DATA_DIR>/utilities/datasets). Blank -> each stays project-relative, same
# as before this was configurable.
DATA_DIR=

# Serial port for the Arduino behind the Room actuator (top/lights/strip/tv/
# audio — see api/services/room.py). Blank -> disabled; room commands 503
# until this is set to the real device (e.g. COM6 on Windows, /dev/ttyUSB0 on Linux).
ARDUINO_DEVICE=

# fn service host:port — it's on the LAN, same network as this backend, so
# calls go straight there instead of round-tripping through PUBLIC_HOST.
# nginx also exposes this service externally at /cyan_pc.
CONTROLS_FN_HOST=xxx.xxx.xxx.xxx:xxxx

# Serper.dev image search (used only by the backend proxy).
SERPER_API_KEY=...
