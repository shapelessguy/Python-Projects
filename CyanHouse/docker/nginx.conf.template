worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Redirect HTTP → HTTPS, except the ACME HTTP-01 challenge Certbot uses to
    # issue/renew the cert — that must stay reachable in plain HTTP.
    server {
        listen 80;
        server_name ${PUBLIC_HOST};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name ${PUBLIC_HOST};

        ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;

        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;

        # Root is a static welcome page (index.html), not the app — the GUI
        # itself lives at /ui/. Absolute path matching docker-compose.yml's
        # bind mount (./docker/html -> /usr/share/nginx/html). Plain prefix
        # location (not `location = /`) — the exact-match form had trouble
        # resolving `index` to this root; more specific locations below
        # (/ui/, /api/, /cyan_pc/) still win for their own paths regardless,
        # since nginx always prefers the longest matching prefix.
        location / {
            root /usr/share/nginx/html;
            index index.html;
        }

        # Bare /ui (no trailing slash) -> /ui/
        location = /ui {
            return 301 /ui/;
        }

        # Browsers auto-request this; avoid it falling through to FastAPI's
        # JSON 404 (which some browsers refuse to render as a favicon).
        location = /favicon.ico {
            return 404;
        }

        # React SPA — built with vite `base: "/ui/"`, so its own asset/favicon
        # requests already come back prefixed /ui/... too. Trailing slash on
        # both the location and proxy_pass strips /ui/ before it reaches the
        # backend, which serves react_ui/dist at its own root (/). host.docker
        # networking isn't used here — this container runs with network_mode:
        # host, so 127.0.0.1 is the Ubuntu host itself, same machine as the
        # FastAPI app.
        location /ui/ {
            proxy_pass http://127.0.0.1:${API_PORT}/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI backend — routers are already prefixed /api/... , so this
        # keeps the prefix as-is (no trailing slash on proxy_pass).
        location /api/ {
            proxy_pass http://127.0.0.1:${API_PORT}/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI's own interactive API docs (Swagger UI at /docs, ReDoc at
        # /redoc, the schema at /openapi.json) — these aren't under /api/, so
        # without this they'd fall through to the static root above and never
        # reach the backend. Unauthenticated by design (FastAPI's built-in
        # routes, not run through require_user like the /api/ ones): you can
        # browse the API shape without signing in, but "Try it out" still
        # hits the real, protected endpoints, so it still needs the same
        # login as the app itself to actually execute anything.
        location ~ ^/(docs|redoc|openapi\.json) {
            proxy_pass http://127.0.0.1:${API_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # CyanControls fn service (CONTROLS_FN_HOST in secrets.json, LAN-only).
        # Clients that used to hit that host:port directly now go through
        # here instead, so it no longer needs to be forwarded from the router.
        # Trailing slash on both location and proxy_pass strips /cyan_pc/.
        location /cyan_pc/ {
            proxy_pass http://${CONTROLS_FN_HOST}:${CONTROLS_FN_PORT}/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # qBittorrent Web UI — running locally on this box (port 8081).
        # Trailing slash on both location and proxy_pass strips /qbt/.
        location /qbt/ {
            proxy_pass http://127.0.0.1:8081/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
