worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Compress text on the way out: the GUIs' code and the JSON of the
    # backends shrink to a fifth or less. Not application/x-ndjson, Lansi's
    # streamed answers of the models, which must go out as they come.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json
               image/svg+xml application/manifest+json text/plain;

    # Who came, to a file rather than the image's default of the container's
    # stdout, which is gone whenever the container is recreated. The folder
    # is docker/logs/nginx on the host (docker-compose.yml); logrotate and
    # fail2ban read it from there (DEPLOY.md). "combined", which fail2ban's
    # filters already parse, with the name asked for and the time taken after.
    log_format cyan '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    '$ssl_server_name $request_time';
    access_log /var/log/cyanhouse/access.log cyan;

    # Password guessing at the sign-in routes, per address: five tries at
    # once, then one every ten seconds; the rest get a 429.
    limit_req_zone $binary_remote_addr zone=login:1m rate=6r/m;
    limit_req_status 429;

    # Anything that does not ask for one of the site's names — scanners going
    # by the bare IP or a made-up name — is dropped unanswered: on 80 by
    # closing the connection (444), on 443 by refusing the TLS handshake, so
    # no certificate is needed for it and the site's names are never shown.
    server {
        listen 80 default_server;
        return 444;
    }
    server {
        listen 443 ssl default_server;
        ssl_reject_handshake on;
    }

    # Redirect HTTP → HTTPS, except the ACME HTTP-01 challenge Certbot uses to
    # issue/renew the cert — that must stay reachable in plain HTTP.
    server {
        listen 80;
        server_name ${SITE_HOSTS};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # The site over HTTPS, written out once per name it goes by (see
    # scripts/render_nginx_conf.py): PUBLIC_HOST from outside, and LAN_HOST
    # at home — a DuckDNS name set to this machine's LAN address, so the
    # browser goes straight to it and still gets a valid certificate (issued
    # over DNS, see DEPLOY.md). A block per name rather than one certificate
    # path with $ssl_server_name in it: nginx loads the certificates at start
    # as root, and its workers could not read the keys to do it later.
    # >>> site
    server {
        listen 443 ssl;
        http2 on;
        server_name ${SITE_HOST};

        ssl_certificate     /etc/letsencrypt/live/${SITE_HOST}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SITE_HOST}/privkey.pem;

        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;

        # Root is a static welcome page (index.html), not the app — the GUI
        # itself lives at /ui/. Absolute path matching docker-compose.yml's
        # bind mount (./docker/html -> /usr/share/nginx/html). Plain prefix
        # location (not `location = /`) — the exact-match form had trouble
        # resolving `index` to this root; more specific locations below
        # (/ui/, /api/) still win for their own paths regardless,
        # since nginx always prefers the longest matching prefix.
        location / {
            root /usr/share/nginx/html;
            index index.html;
        }

        # Bare /ui (no trailing slash) -> /ui/
        location = /ui {
            return 301 /ui/;
        }

        # Browsers auto-request this; avoid it falling through to FastAPI's
        # JSON 404 (which some browsers refuse to render as a favicon).
        location = /favicon.ico {
            return 404;
        }

        # React SPA — built with vite `base: "/ui/"`, so its own asset/favicon
        # requests already come back prefixed /ui/... too. Trailing slash on
        # both the location and proxy_pass strips /ui/ before it reaches the
        # backend, which serves react_ui/dist at its own root (/). host.docker
        # networking isn't used here — this container runs with network_mode:
        # host, so 127.0.0.1 is the Ubuntu host itself, same machine as the
        # FastAPI app.
        location /ui/ {
            proxy_pass http://127.0.0.1:${API_PORT}/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The movie stream is one long-lived response carrying a live
        # transcode. nginx's default response buffering would hold it back
        # (and spool it to disk) instead of passing fragments through as
        # ffmpeg writes them, and the default 60s proxy_read_timeout would
        # cut off a stream that's merely paused — the browser stops reading,
        # ffmpeg blocks on a full pipe, and nothing crosses the proxy until
        # play is pressed again. Hence its own location, ahead of /api/.
        location /api/movies/stream {
            proxy_pass http://127.0.0.1:${API_PORT}/api/movies/stream;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Resumable uploads (tus). Its own block for three reasons: the
        # default 1 MB client_max_body_size would reject every chunk, request
        # buffering would spool each one to disk before the backend saw it
        # (doubling the write for a file that is already gigabytes), and a
        # slow link needs longer than the default 60s to push one across.
        # The cap is deliberately a little above the backend's own
        # MAX_CHUNK_BYTES, so an over-large chunk is refused by the
        # application with a message rather than by nginx with a bare 413.
        location /api/uploads {
            proxy_pass http://127.0.0.1:${API_PORT}/api/uploads;
            proxy_http_version 1.1;
            client_max_body_size 64m;
            proxy_request_buffering off;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The Controls panel's Mouse section: a WebSocket, relayed on to
        # CyanManager (api/routers/controls.py). nginx only passes the
        # upgrade on when asked to, and the default 60s proxy_read_timeout
        # would drop a socket left idle between touches (the app pings every
        # 15s, but a longer margin costs nothing).
        location = /api/controls/mouse {
            proxy_pass http://127.0.0.1:${API_PORT}/api/controls/mouse;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The Controls "PC audio" players: a WebSocket relayed from
        # CyanManager, as /api/controls/mouse is. The PC sends nothing while
        # it is silent, which can be hours; uvicorn pings the client every
        # 20s, which is what keeps nginx reading, the timeouts only a margin.
        location = /api/controls/audio {
            proxy_pass http://127.0.0.1:${API_PORT}/api/controls/audio;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Bare /lansi (no trailing slash) -> /lansi/
        location = /lansi {
            return 301 /lansi/;
        }

        # Lansi, the language-learning chat (~/Documents/Lansi). Its checker
        # server, which the GUI asks everything of, with the prefix taken
        # off; it asks for its own login, and the Anki server behind it is
        # never reachable from here. Not buffered, so that the answers of the
        # models stream through as they are written; the body size is that
        # of the EPUB books (the checker takes up to 200 MB); the timeouts
        # let a slow answer of the language models through.
        location /lansi/checker/ {
            proxy_pass http://127.0.0.1:8092/;
            proxy_http_version 1.1;
            proxy_buffering off;
            client_max_body_size 200m;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Lansi's GUI, as built (chat-ui/dist, mounted at /srv/lansi). The
        # files in assets/ are named for what is in them, so they are kept
        # for a year; index.html, which names them, is asked for again every
        # time, so that a new build is taken at once.
        location /lansi/assets/ {
            alias /srv/lansi/assets/;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        location /lansi/ {
            alias /srv/lansi/;
            try_files $uri $uri/ /lansi/index.html;
            add_header Cache-Control "no-cache";
        }

        # The sign-in routes, throttled (the login zone, above).
        location = /api/login {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://127.0.0.1:${API_PORT}/api/login;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location = /api/token {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://127.0.0.1:${API_PORT}/api/token;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI backend — routers are already prefixed /api/... , so this
        # keeps the prefix as-is (no trailing slash on proxy_pass).
        location /api/ {
            proxy_pass http://127.0.0.1:${API_PORT}/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
    # <<< site
}
