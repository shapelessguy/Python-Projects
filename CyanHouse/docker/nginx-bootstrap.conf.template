worker_processes 1;

events {
    worker_connections 1024;
}

# One-time bootstrap config: HTTP only, no ssl_certificate directive. nginx
# refuses to start at all if the 443 server block in nginx.conf references a
# cert file that doesn't exist yet — so before the very first certificate is
# issued, start nginx with THIS file instead (see docker/README.md), get the
# cert via the certbot service, then switch to nginx.conf and restart.
http {
    include       mime.types;
    default_type  application/octet-stream;

    server {
        listen 80;
        server_name cyanroomserver.duckdns.org;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 200 "nginx bootstrap: waiting for first TLS certificate.\n";
            add_header Content-Type text/plain;
        }
    }
}
