#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# The linuxserver/qbittorrent image's own start script, with one addition:
# before qBittorrent starts, its settings are made to bind the torrents to
# the VPN interface (VPN_INTERFACE, nordlynx). Bound to it, qBittorrent has
# no way out when the VPN is down — the interface is gone, and nothing
# falls back to the open line. Whatever the settings file says (changed in
# the web UI, or a fresh one), it is put back here at every start; while it
# runs, the API's proxy refuses changes to it (api/routers/qbt.py).
# Mounted over the original by docker-compose.yml — recheck against the
# image's copy if an update breaks it.

CONF=/config/qBittorrent/qBittorrent.conf
VPN=${VPN_INTERFACE:-nordlynx}
mkdir -p "$(dirname "${CONF}")"
touch "${CONF}"
# Rewritten through a temp file and copied back into the same file, so it
# keeps its owner (abc). Session\* is what qBittorrent reads; the old
# Connection\* keys get the same value so nothing disagrees.
awk -v vpn="${VPN}" '
    /^Session\\Interface(Name)?=/ { next }
    /^Connection\\Interface(Name)?=/ { sub(/=.*/, "=" vpn); print; next }
    { print }
    $0 == "[BitTorrent]" { print "Session\\Interface=" vpn; print "Session\\InterfaceName=" vpn; done = 1 }
    END { if (!done) { print ""; print "[BitTorrent]"; print "Session\\Interface=" vpn; print "Session\\InterfaceName=" vpn } }
' "${CONF}" > /tmp/qBittorrent.conf && cat /tmp/qBittorrent.conf > "${CONF}" && rm /tmp/qBittorrent.conf

WEBUI_ADDRESS=$(grep -Po "^WebUI\\\Address=\K(.*)" /config/qBittorrent/qBittorrent.conf)
if [[ -z ${WEBUI_ADDRESS} ]] || [[ ${WEBUI_ADDRESS} == "*" ]]; then
    WEBUI_ADDRESS="localhost"
fi

if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z ${WEBUI_ADDRESS} ${WEBUI_PORT:-8080}" \
        s6-setuidgid abc /app/qbittorrent-nox --webui-port="${WEBUI_PORT:-8080}" ${TORRENTING_PORT+--torrenting-port=${TORRENTING_PORT}}
else
exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z ${WEBUI_ADDRESS} ${WEBUI_PORT:-8080}" \
        /app/qbittorrent-nox --webui-port="${WEBUI_PORT:-8080}" ${TORRENTING_PORT+--torrenting-port=${TORRENTING_PORT}}
fi
