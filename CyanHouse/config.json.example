{
  "WEB_PORT": "5173",
  "API_PORT": "18000",
  "PUBLIC_HOST": "xxx.duckdns.org",
  "LAN_HOST": "xxx-lan.duckdns.org",
  "DATA_DIR": "",
  "USERS_FILE": "",
  "CONTROLS_FN_HOST": "xxx.xxx.xxx.xxx",
  "CONTROLS_FN_PORT": "xxxx",
  "LLM_FOOD_MODEL": "openai/gpt-4o-mini",
  "MOVIES_DIR": "/mnt/earth/CYAN/Video/Movies",
  "MUSIC_DIR": "",
  "IMAGE_DIR": "",
  "DOCUMENTS_DIR": "",
  "ROUTER_UPNP_URL": "http://192.168.178.1:49000",
  "staging": {
    "TV Series": {
      "type": "film",
      "output": "/path/to/your/series/library",
      "description": {
        "en": "The TV series, one folder per show. A Plex library used on its own (Plex shows it as **TV Shows**): Plex recognises the episodes by their names, so it does not have to be perfectly tidy.",
        "it": "Le serie TV, una cartella per serie. Una libreria Plex usata da sola (Plex la mostra come **TV Shows**): Plex riconosce gli episodi dai nomi, quindi non serve che sia perfettamente in ordine."
      },
      "moves_to": [
        "downloads"
      ]
    },
    "Audio extraction": {
      "type": "film",
      "icon": "🎚️",
      "output": "/path/to/extracted/tracks",
      "description": {
        "en": "The audio and subtitle tracks pulled out of videos with **Extract tracks** in a folder's selection bar, each as it was in the video (no re-encoding), named **Episode.ita.ac3**, **Episode.eng.srt** and so on, in the same folders as the videos they came from.",
        "it": "Le tracce audio e sottotitoli estratte dai video con **Estrai tracce** nella barra della selezione, ognuna com'era nel video (senza ricodifica), chiamate **Episodio.ita.ac3**, **Episodio.eng.srt** e così via, nelle stesse cartelle dei video da cui vengono.",
        "de": "Die Ton- und Untertitelspuren, die mit **Spuren extrahieren** in der Auswahlleiste aus Videos geholt wurden, jede so, wie sie im Video war (ohne Neukodierung), benannt als **Folge.ita.ac3**, **Folge.eng.srt** usw., in denselben Ordnern wie die Videos, aus denen sie stammen."
      }
    },
    "Audio": {
      "type": "music",
      "icon": "🎧",
      "inbox": "/path/to/songs/waiting",
      "output": "/path/where/tagged/songs/go",
      "description": {
        "en": "Songs waiting to be recognised, tagged and filed as Artist/Album/NN - Title.",
        "it": "Canzoni in attesa di essere riconosciute, taggate e archiviate come Artista/Album/NN - Titolo."
      },
      "moves_to": [
        "downloads",
        "Music"
      ]
    },
    "downloads": {
      "type": "film",
      "inbox": "/path/to/dirty/downloads",
      "output": "/path/where/finished/films/go",
      "description": {
        "en": "Where finished downloads land — both torrents (**🧲 Torrents**) and hoster/debrid downloads (**⬇ Downloads**) end up in the inbox by themselves.",
        "it": "Qui arrivano i download finiti — sia i torrent (**🧲 Torrents**) sia i download da hoster/debrid (**⬇ Downloads**) finiscono da soli nell'inbox."
      },
      "moves_to": [
        "*"
      ]
    }
  },
  "library_moves": {
    "Movies": [
      "downloads"
    ]
  },
  "extract_to": "Audio extraction"
}
